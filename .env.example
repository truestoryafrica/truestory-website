NEXT_PUBLIC_SITE_URL=https://truestoryafrica.com

# Database (Postgres) — run lib/schema.sql once against this database first.
DATABASE_URL=postgres://user:password@host:5432/database

# Image uploads — Supabase Storage (same project as the database above).
# Project Settings → Data API in your Supabase dashboard for the URL,
# Project Settings → API Keys for the anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=

# Admin login
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_TOKEN=change-this-long-random-token

# Admin password reset — email delivery via Resend (resend.com, free tier).
# The reset link always goes to the site's own email address (see content/site.js).
RESEND_API_KEY=
# Optional: a verified sending domain, e.g. "TrueStory Africa <hello@truestoryafrica.com>".
# Leave unset to send from Resend's shared onboarding@resend.dev address (works immediately).
RESEND_FROM_EMAIL=

# Contact form delivery — email notification via Formspree (formspree.io)
# The form ID from your Formspree dashboard, e.g. "xpqbypla" from formspree.io/f/xpqbypla
FORMSPREE_FORM_ID=

# Optional: also forward each lead to a generic automation webhook (Zapier, Make, etc.)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# SEO ownership verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
